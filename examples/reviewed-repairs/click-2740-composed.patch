+def test_exception_notes(runner):
+    notes_supported = hasattr(BaseException, "add_note")
+
+    @click.command()
+    def click_exc():
+        exc = click.ClickException("foo")
+        if notes_supported:
+            exc.add_note("bar")
+        raise exc
+
+    result = runner.invoke(click_exc)
+    assert result.exit_code == 1
+    assert result.output == (
+        "Error: foo\nbar\n" if notes_supported else "Error: foo\n"
+    )
+
+    def fail(ctx, param, value):
+        exc = click.BadParameter("boom", param=param)
+        if notes_supported:
+            exc.add_note("baz")
+        raise exc
+
+    @click.command()
+    @click.option("--value", callback=fail)
+    def bad_param(value):
+        pass
+
+    result = runner.invoke(bad_param, ["--value", "x"])
+    assert result.exit_code == 2
+    assert "Error: Invalid value for '--value': boom" in result.output
+    if notes_supported:
+        assert "baz" in result.output
+    else:
+        assert "baz" not in result.output
+
+    from click.exceptions import NoArgsIsHelpError
+
+    class HelpCommand(click.Command):
+        def parse_args(self, ctx, args):
+            try:
+                return super().parse_args(ctx, args)
+            except NoArgsIsHelpError as exc:
+                if notes_supported:
+                    exc.add_note("qux")
+                raise
+
+    @click.command("cli", cls=HelpCommand, no_args_is_help=True)
+    def help_cli():
+        pass
+
+    result = runner.invoke(help_cli, [])
+    assert result.exit_code == 2
+    assert result.output.startswith("Usage: cli [OPTIONS]\n")
+    if notes_supported:
+        assert result.output.endswith("qux\n")
+    else:
+        assert "qux" not in result.output
+
+
