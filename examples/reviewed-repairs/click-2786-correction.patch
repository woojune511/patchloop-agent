     assert fetch_calls == 2
 
 
+def test_shared_option_callback_validation_for_omitted_custom_option(runner):
+    observations = []
+    for reject in (False, True):
+        seen = []
+        fetch_calls = 0
+
+        def fetch():
+            nonlocal fetch_calls
+            fetch_calls += 1
+            return "foo"
+
+        def callback(ctx, param, value):
+            seen.append(value)
+            if reject:
+                raise click.BadParameter("blocked by omitted option validation")
+            return fetch()
+
+        @click.command()
+        @click.option("--custom", "custom", callback=callback)
+        @click.option("--fetch", "custom", flag_value="blocked")
+        def cli(custom):
+            click.echo(custom)
+
+        result = runner.invoke(cli, ["--fetch"])
+        observations.append(
+            {
+                "reject": reject,
+                "callback_values": seen,
+                "exit_code": result.exit_code,
+                "output": result.output,
+                "fetch_calls": fetch_calls,
+            }
+        )
+
+    assert observations[0]["callback_values"] == ["blocked"]
+    assert observations[0]["fetch_calls"] == 1
+    assert observations[0]["exit_code"] == 0
+    assert observations[0]["output"] == "foo\n"
+    assert observations[1]["callback_values"] == ["blocked"]
+    assert observations[1]["fetch_calls"] == 0
+    assert observations[1]["exit_code"] == 2
+
+
 @pytest.mark.parametrize(
