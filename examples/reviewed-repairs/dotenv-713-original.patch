+@pytest.mark.parametrize(
+    "rewrite, expected_result, expected_content",
+    [
+        (lambda path: dotenv.set_key(path, "a", "y"), (True, "a", "y"), "a='y'\n"),
+        (lambda path: dotenv.unset_key(path, "a"), (True, "a"), ""),
+    ],
+    ids=["set_key", "unset_key"],
+)
+def test_rewrite_fsyncs_before_replace(tmp_path, rewrite, expected_result, expected_content):
+    dotenv_path = tmp_path / ".env"
+    dotenv_path.write_text("a=x\n")
+    events = []
+    real_replace = os.replace
+
+    def fsync(fd):
+        events.append("fsync")
+        return None
+
+    def replace(src, dst):
+        events.append("replace")
+        real_replace(src, dst)
+
+    with mock.patch("dotenv.main.os.fsync", side_effect=fsync):
+        with mock.patch("dotenv.main.os.replace", side_effect=replace):
+            result = rewrite(dotenv_path)
+
+    assert events == ["fsync", "replace"]
+    assert result == expected_result
+    assert dotenv_path.read_text() == expected_content
+
+
