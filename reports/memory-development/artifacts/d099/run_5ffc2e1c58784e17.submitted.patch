+def _rebase_refresh_route(refresh_route: str, endpoint: Optional[str]) -> str:
+    if endpoint is None:
+        return refresh_route
+
+    parsed_refresh_route = urlparse(refresh_route)
+    if not parsed_refresh_route.scheme or not parsed_refresh_route.netloc:
+        return refresh_route
+
+    parsed_default_origin = urlparse(constants.HUGGINGFACE_CO_URL_HOME)
+    if (parsed_refresh_route.scheme, parsed_refresh_route.netloc) != (
+        parsed_default_origin.scheme,
+        parsed_default_origin.netloc,
+    ):
+        return refresh_route
+
+    relative_route = parsed_refresh_route.path.lstrip("/")
+    if parsed_refresh_route.query:
+        relative_route += f"?{parsed_refresh_route.query}"
+    if parsed_refresh_route.fragment:
+        relative_route += f"#{parsed_refresh_route.fragment}"
+    return urljoin(endpoint.rstrip("/") + "/", relative_route)
+
