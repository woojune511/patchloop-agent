FROM patchloop-probe-python312:security-20261023@sha256:3b37b00de42a063f990e9b55d3918bb0a64cf5ec533a79e9650ca3ce9ccbe3b1

RUN useradd --create-home --uid 10001 sandbox
COPY --chmod=0555 probe_runner.py /opt/patchloop/probe_runner.py
LABEL io.patchloop.probe-image="v2"
USER sandbox
WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "-c", "print('PatchLoop sandbox image ready')"]
