+def write_OLvalue(fp: DicomIO, elem: DataElement) -> None:
+    """Write a data_element with VR of 'other long' (OL)."""
+    val = elem.value
+    if _is_multi_value(val):
+        endianChar = '><'[fp.is_little_endian]
+        format_string = endianChar + 'L'
+        try:
+            for item in cast(Iterable[Any], val):
+                fp.write(pack(format_string, item))
+        except Exception as e:
+            raise IOError(
+                f"{str(e)}\nfor data_element:\n{str(elem)}"
+            )
+    else:
+        fp.write(cast(bytes, val))
+
+
 def write_UI(fp: DicomIO, elem: DataElement) -> None:
     """Write a data_element with VR of 'unique identifier' (UI)."""
     write_string(fp, elem, '\0')  # pad with 0-byte to even length
